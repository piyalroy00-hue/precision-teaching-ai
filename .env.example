# Flask Configuration
FLASK_ENV=production
FLASK_APP=app.main

# Database (optional - defaults to precision_teaching.db in project root)
DATABASE_URL=sqlite:///precision_teaching.db

# AI Tutor Provider (local or openai)
AI_TUTOR_PROVIDER=local

# Optional: OpenAI Configuration (only if AI_TUTOR_PROVIDER=openai)
# OPENAI_API_KEY=your_key_here
# OPENAI_TUTOR_MODEL=gpt-4o-mini
